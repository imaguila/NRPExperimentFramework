{
  "name": "WordProc_50",
  "num_requirements": 50,
  "description": "Word Processing Tool release-planning instance reconstructed from the original workbook.",
  "metadata": {
    "source_files": [
      "wordproc.xls",
      "wordprocdataset.txt"
    ],
    "project": {
      "title": "word weighted groups",
      "description": "Word Processing Tool",
      "releases": [
        {
          "name": "Winter, 2008 Release",
          "weight": 9.0,
          "criterion": "Urgency",
          "criterion_weight": 9.0
        },
        {
          "name": "Spring, 2008 Release",
          "weight": 8.0,
          "criterion": "Value",
          "criterion_weight": 5.0
        },
        {
          "name": "Fall, 2008 Release",
          "weight": 8.0
        }
      ]
    },
    "adaptation_notes": [
      "The JSON represents all 50 requirements listed in the Requirements worksheet.",
      "Effort is the sum of Requirement Elicitation, Design, Application Development, External Tools Development, and QA / Testing estimates.",
      "The supplied text file contains 42 already transformed decision rows and is retained as a reference artefact; the original 50-requirement JSON is reconstructed from the workbook sheets.",
      "For every requirement, effort is calculated as the sum of the five resource-estimate columns in the workbook.",
      "Value and urgency preserve the four original stakeholder scores; weighted_mean is used for evaluator aggregation.",
      "The Precedes column is represented literally as from=<row requirement>, to=<listed requirement>.",
      "Coupling lists are expanded into pairwise source relationships; transitive components are left to NRP-Exp preprocessing.",
      "Advanced dependencies modify the value attribute and are represented as multipliers 1+p, where p is the stated percentage increase.",
      "Release-specific resource capacities and release weights are retained as metadata and are not collapsed into a single threshold constraint."
    ],
    "release_resource_capacities": {
      "Winter, 2008 Release": {
        "Requirement Elicitation": 150.0,
        "Design": 150.0,
        "Application Development": 200.0,
        "External Tools Development": 75.0,
        "QA / Testing": 150.0
      },
      "Spring, 2008 Release": {
        "Requirement Elicitation": 150.0,
        "Design": 150.0,
        "Application Development": 180.0,
        "External Tools Development": 73.0,
        "QA / Testing": 140.0
      },
      "Fall, 2008 Release": {
        "Requirement Elicitation": 150.0,
        "Design": 150.0,
        "Application Development": 175.0,
        "External Tools Development": 70.0,
        "QA / Testing": 130.0
      }
    },
    "txt_transformed_rows": 42
  },
  "attribute_definitions": {
    "effort": {
      "type": "scalar",
      "description": "Total person-hours across the five resource-estimate categories",
      "coupling_rule": "sum",
      "evaluation_rule": "sum"
    },
    "value": {
      "type": "multivalued",
      "evaluator_group": "stakeholders",
      "description": "Per-stakeholder value score from the Value worksheet",
      "coupling_rule": "sum",
      "aggregation_rule": "weighted_mean",
      "evaluation_rule": "sum"
    },
    "urgency": {
      "type": "multivalued",
      "evaluator_group": "stakeholders",
      "description": "Per-stakeholder urgency score from the Urgency worksheet",
      "coupling_rule": "sum",
      "aggregation_rule": "weighted_mean",
      "evaluation_rule": "sum"
    }
  },
